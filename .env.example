# === Required ===

# Telegram Bot (Phase 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Supabase Database (Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Personalization (Phase 3)
USER_NAME=
USER_TIMEZONE=America/New_York
ASSISTANT_NAME=Beckett

# === Optional ===

# Claude Code CLI path (defaults to "claude")
# CLAUDE_PATH=claude

# Voice Transcription (Phase 7)
# Option A: Groq cloud API (free tier, recommended)
# VOICE_PROVIDER=groq
# GROQ_API_KEY=
# Option B: local whisper.cpp (offline, private; needs ffmpeg + whisper-cpp)
# VOICE_PROVIDER=local
# WHISPER_BINARY=whisper-cpp
# WHISPER_MODEL_PATH=
